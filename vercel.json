{
  "redirects": [
    {
      "source": "/sistema-ecommerce",
      "destination": "/sistema-ecommerce/",
      "permanent": true
    },
    {
      "source": "/sistema-gimnasios",
      "destination": "/sistema-gimnasios/",
      "permanent": true
    },
    {
      "source": "/sistema-gastronomia",
      "destination": "/sistema-cafeteria/",
      "permanent": true
    },
    {
      "source": "/sistema-gastronomia/",
      "destination": "/sistema-cafeteria/",
      "permanent": true
    },
    {
      "source": "/sistema-cafeteria",
      "destination": "/sistema-cafeteria/",
      "permanent": true
    },
    {
      "source": "/ecommerce",
      "destination": "/tienda-online",
      "permanent": true
    },
    {
      "source": "/gimnasios",
      "destination": "/software-para-gimnasios",
      "permanent": true
    },
    {
      "source": "/turneros",
      "destination": "/sistema-de-turnos",
      "permanent": true
    },
    {
      "source": "/gastronomia",
      "destination": "/software-para-restaurantes",
      "permanent": true
    },
    {
      "source": "/clinica-medica",
      "destination": "/software-para-clinicas",
      "permanent": true
    },
    {
      "source": "/pos",
      "destination": "/sistema-pos",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://crm.codigonortesoluciones.com/api/:path*"
    },
    {
      "source": "/sistema-cafeteria/app/:path*",
      "destination": "/sistema-cafeteria/app/index.html"
    },
    {
      "source": "/tienda-online",
      "destination": "/tienda-online.html"
    },
    {
      "source": "/software-para-gimnasios",
      "destination": "/software-para-gimnasios.html"
    },
    {
      "source": "/sistema-de-turnos",
      "destination": "/sistema-de-turnos.html"
    },
    {
      "source": "/software-para-restaurantes",
      "destination": "/software-para-restaurantes.html"
    },
    {
      "source": "/software-para-clinicas",
      "destination": "/software-para-clinicas.html"
    },
    {
      "source": "/sistema-pos",
      "destination": "/sistema-pos.html"
    },
    {
      "source": "/sistemas-de-ia",
      "destination": "/sistemas-de-ia.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/HEROVIDEO.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
