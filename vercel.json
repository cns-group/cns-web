{
  "redirects": [
    { "source": "/sistema-ecommerce", "destination": "/sistema-ecommerce/", "permanent": true },
    { "source": "/sistema-gimnasios", "destination": "/sistema-gimnasios/", "permanent": true },
    { "source": "/sistema-gastronomia", "destination": "/sistema-cafeteria/", "permanent": true },
    { "source": "/sistema-gastronomia/", "destination": "/sistema-cafeteria/", "permanent": true },
    { "source": "/sistema-cafeteria", "destination": "/sistema-cafeteria/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sistema-cafeteria/app/:path*", "destination": "/sistema-cafeteria/app/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
